<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureFileManager.Maui.Views.LoginPage"
             Title="Secure File Manager">

    <StackLayout Padding="20" Spacing="20">
        <Label Text="Secure File Manager" FontSize="24" HorizontalOptions="Center" />
        <Entry x:Name="UsernameEntry" Placeholder="Email or Mobile" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
        <Button Text="Login" Clicked="OnLoginClicked" />
        <Button Text="Use OTP" Clicked="OnOtpClicked" />
    </StackLayout>
</ContentPage>
