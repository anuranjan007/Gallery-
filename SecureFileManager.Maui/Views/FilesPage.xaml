<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureFileManager.Maui.Views.FilesPage"
             Title="Files">
    <StackLayout Padding="10">
        <Label x:Name="FolderTitle" FontSize="18" />
        <Button Text="Upload File" Clicked="OnUploadClicked" />
        <CollectionView x:Name="FilesList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackLayout>
                                <Label Text="{Binding OriginalFileName}" />
                                <Label Text="{Binding ContentType}" FontSize="12" />
                            </StackLayout>
                            <Button Text="Download" Grid.Column="1" Clicked="OnDownloadClicked" CommandParameter="{Binding Id}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
