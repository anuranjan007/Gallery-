<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureFileManager.Maui.Views.OtpPage"
             Title="OTP Verification">
    <StackLayout Padding="20" Spacing="20">
        <Label Text="Enter OTP sent to your email/phone" />
        <Entry x:Name="OtpEntry" Placeholder="6-digit code" Keyboard="Numeric" />
        <Button Text="Verify" Clicked="OnVerifyClicked" />
    </StackLayout>
</ContentPage>
